# ---- Secrets / environment (NEVER commit) ----
.env
.env.*
!.env.example
*.pem
*.key
credentials
aws.json

# ---- Java / Maven ----
target/
*.class
*.jar
*.war
!.mvn/wrapper/maven-wrapper.jar
.mvn/timing.properties

# ---- Gradle (if used instead) ----
.gradle/
build/

# ---- IDE ----
.idea/
*.iml
*.ipr
*.iws
.vscode/
.settings/
.project
.classpath

# ---- Local scratch / media (don't commit test videos or transcode output) ----
scratch/
tmp/
*.mp4
*.mov
*.ts
*.m3u8
!docs/**/*.mp4

# ---- Python (scripts/: smoke.py, bench.py) ----
__pycache__/
*.pyc

# ---- Node (hls.js demo frontend, if added) ----
node_modules/
dist/
npm-debug.log*

# ---- OS ----
.DS_Store
Thumbs.db

# ---- Logs ----
*.log
logs/

# ---- Working docs: local-only, untracked on every branch ----
# Kept on disk as working notes but out of git, so a file that changes locally but is absent
# on main can't cause modify/delete merge conflicts. Untracked via `git rm --cached`.
CLAUDE.md
DEVLOG.md
HANDOFF.md
