# ---- Secrets / environment (NEVER commit) ----
.env
.env.*
!.env.example
*.pem
*.key
credentials
aws.json

# ---- Java / Maven ----
target/
*.class
*.jar
*.war
!.mvn/wrapper/maven-wrapper.jar
.mvn/timing.properties

# ---- Gradle (if used instead) ----
.gradle/
build/

# ---- IDE ----
.idea/
*.iml
*.ipr
*.iws
.vscode/
.settings/
.project
.classpath

# ---- Local scratch / media (don't commit test videos or transcode output) ----
scratch/
tmp/
*.mp4
*.mov
*.ts
*.m3u8
!docs/**/*.mp4

# ---- Python (scripts/: smoke.py, bench.py) ----
__pycache__/
*.pyc

# ---- Node (hls.js demo frontend, if added) ----
node_modules/
dist/
npm-debug.log*

# ---- OS ----
.DS_Store
Thumbs.db

# ---- Logs ----
*.log
logs/

# ---- Working docs: live on the dev branch, kept OFF main ----
# Tracked on dev (this rule is a no-op for already-tracked files there). On main they are
# git-rm'd once; this rule then stops a promote from re-adding them.
CLAUDE.md
DEVLOG.md
HANDOFF.md
