# Copy to .env and fill in. NEVER commit the real .env.

# ---- AWS S3 ----
# NOTE: docker-compose already provides working local defaults (MinIO, bucket "transcoder",
# minioadmin/minioadmin, endpoint http://minio:9000). You only need a .env to override them
# or to point at real AWS. For real AWS use a dedicated least-privilege IAM user and leave
# the endpoint unset.
AWS_REGION=us-east-1
AWS_S3_BUCKET=transcoder
AWS_ACCESS_KEY_ID=minioadmin        # real AWS: dedicated least-privilege IAM key
AWS_SECRET_ACCESS_KEY=minioadmin    # real AWS: the matching secret
# S3-compatible endpoint for local MinIO; leave blank/unset for real AWS.
# In docker-compose the app reaches MinIO at http://minio:9000 (set there directly).
AWS_S3_ENDPOINT=

# ---- PostgreSQL ----
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=transcoder
POSTGRES_USER=transcoder
POSTGRES_PASSWORD=change_me

# ---- RabbitMQ ----
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# ---- ClamAV ----
CLAMAV_HOST=clamav
CLAMAV_PORT=3310

# ---- Pipeline tuning (see docs/architecture-and-workflow.md) ----
OUTPUT_MODE=mp4               # mp4 | hls
SEGMENT_TARGET_SECONDS=8
MAX_DURATION_SECONDS=300      # 5 min
MAX_SIZE_BYTES=2147483648     # ~2 GB
RETRY_MAX_ATTEMPTS=3
RETRY_BACKOFF_SECONDS=2,8,30
PREFETCH=1
IN_FLIGHT_JOB_CAP=50
UPLOAD_DEADLINE_MINUTES=60
DOWNLOAD_URL_TTL_MINUTES=60   # lifetime of presigned GET URLs returned by GET /jobs/{id}
