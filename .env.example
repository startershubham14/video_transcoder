# Copy to .env and fill in. NEVER commit the real .env.

# ---- AWS S3 ----
AWS_REGION=us-east-1
AWS_S3_BUCKET=your-bucket-name
AWS_ACCESS_KEY_ID=            # dedicated least-privilege IAM user; leave blank here
AWS_SECRET_ACCESS_KEY=        # leave blank here
# For local S3-compatible storage (MinIO) instead of real AWS, set an endpoint:
# AWS_S3_ENDPOINT=http://localhost:9000

# ---- PostgreSQL ----
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=transcoder
POSTGRES_USER=transcoder
POSTGRES_PASSWORD=change_me

# ---- RabbitMQ ----
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# ---- ClamAV ----
CLAMAV_HOST=clamav
CLAMAV_PORT=3310

# ---- Pipeline tuning (see docs/architecture-and-workflow.md) ----
OUTPUT_MODE=mp4               # mp4 | hls
SEGMENT_TARGET_SECONDS=8
MAX_DURATION_SECONDS=300      # 5 min
MAX_SIZE_BYTES=2147483648     # ~2 GB
RETRY_MAX_ATTEMPTS=3
RETRY_BACKOFF_SECONDS=2,8,30
PREFETCH=1
IN_FLIGHT_JOB_CAP=50
UPLOAD_DEADLINE_MINUTES=60
